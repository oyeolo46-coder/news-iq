# News IQ - Environment Configuration
# Copy this to .env and fill in your actual values

# =============================================================================
# API KEYS
# =============================================================================
NEWSAPI_KEY=your_newsapi_key_here
SERPAPI_KEY=your_serpapi_key_here
CLAUDE_API_KEY=sk-ant-api03-your_claude_key_here

# Google Cloud (TTS + Drive + YouTube)
GOOGLE_TTS_KEY=path/to/google-credentials.json
GOOGLE_DRIVE_CREDENTIALS_PATH=path/to/drive-credentials.json
GOOGLE_FOLDER_ID=your_drive_folder_id

# YouTube API (OAuth - for posting)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# TikTok API
TIKTOK_API_KEY=your_tiktok_key
TIKTOK_ACCESS_TOKEN=your_tiktok_token

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# Twilio (WhatsApp notifications)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/news_iq

# =============================================================================
# USER SETTINGS
# =============================================================================
USER_EMAIL=your@email.com
USER_PHONE=+1234567890

# =============================================================================
# SERVICE URLs (for n8n to call Python service)
# =============================================================================
VIDEO_SERVICE_URL=http://localhost:8001
EMBEDDING_SERVICE_URL=http://localhost:8001

# =============================================================================
# N8N SETTINGS
# =============================================================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_n8n_api_key

# =============================================================================
# OPTIONAL
# =============================================================================
# Slack webhook for error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Sentry for error tracking
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz